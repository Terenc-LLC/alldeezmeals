# Server-side (Vercel Environment Variables → add in dashboard, not committed to git)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# SUPABASE_SERVICE_ROLE_KEY — server-side only; used by /api/ingest-order (and future
# service-role endpoints) to write the shared catalog, bypassing RLS.
# IMPORTANT: use the LEGACY service_role JWT (starts with "eyJ..."), found under
# Supabase → API Keys → "Legacy anon, service_role API keys" tab. Do NOT use the new
# "sb_secret_..." key — it does NOT bypass RLS via supabase-js in this project, so catalog
# writes are rejected (every row fails). Never expose in the client bundle / no VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-jwt-here

# Client-side / public (VITE_-prefixed, safe to expose in browser bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Removed: APP_PASSPHRASE (TER-187 — replaced by Supabase invite-only auth)
