# Server-side (Vercel Environment Variables → add in dashboard, not committed to git)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
APP_PASSPHRASE=your-secret-passphrase-here

# Client-side (must equal APP_PASSPHRASE; ships in the browser bundle)
# This is an abuse speed-bump, not real auth — the hard backstop is your Anthropic spend cap.
VITE_APP_PASSPHRASE=your-secret-passphrase-here
